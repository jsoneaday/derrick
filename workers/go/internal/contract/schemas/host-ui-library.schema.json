{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derrick.local/schemas/host-ui-library.schema.json",
  "title": "Host UI library",
  "description": "Vendor-agnostic UI elements the host can build. The plugin builder may only request these ids.",
  "type": "object",
  "required": ["version", "elements"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "elements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "config": { "type": "object" },
          "binds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": { "$ref": "host-ui-node.schema.json" }
    }
  }
}
