<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>VUSK4B2YKQ.derrick.shared</string>
	</array>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/LaunchAgents/</string>
	</array>
	<key>com.apple.security.temporary-exception.xpc-service-name</key>
	<array>
		<string>derrick.ui.DockerRunnerHelper</string>
		<string>derrick.ui.AgentService</string>
		<string>derrick.ui.MCPService</string>
		<string>derrick.ui.JobService</string>
	</array>
</dict>
</plist>
