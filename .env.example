# Copy to ui/ui/Resources/.env for local development.
# Never commit the real .env file.

UI_SECRET_MODE=dotenv
IS_DEBUG=true

# LLM providers (bring your own keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# Signed XPC between UI services (debug only; release uses Keychain)
MESSAGES_SECRET_KEY=change-me-in-dev

# Messaging connector credentials are saved in-app (Keychain) when you open a connector
# or use /edit-plugin <id> credentials. They are not read from this file.
