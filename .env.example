# Copy to ui/ui/Resources/.env for local development.
# Never commit the real .env file.

UI_SECRET_MODE=dotenv
IS_DEBUG=true

# LLM providers (bring your own keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# Signed XPC between UI services (debug only; release uses Keychain)
MESSAGES_SECRET_KEY=change-me-in-dev

# Plugin connector secrets (example: slack-connection bot token)
SLACK_BOT_KEY=
